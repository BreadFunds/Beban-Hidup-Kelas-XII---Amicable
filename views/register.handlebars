<style>
  /* Same CSS as the login page above */
  html, body {
    background-color: #0e1013;
    color: #f7f9f9;
    margin: 0; padding: 0;
    width: 100%; min-height: 100vh;
  }
  .bg-wrapper { position: relative; min-height: 100vh; width: 100%; overflow: hidden; background-color: #0e1013; }
  .bg-wrapper::before { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: url('/images/homeimage.jpeg') center/cover no-repeat; filter: blur(45px) brightness(0.65); opacity: 0.35; transform: scale(1.2); z-index: 0; }
  .bg-wrapper::after { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(ellipse at center, rgba(14, 16, 19, 0) 20%, rgba(14, 16, 19, 0.5) 75%, #0e1013 100%); pointer-events: none; z-index: 0; }
  .content-container { position: relative; z-index: 1; }
  
  .hero-img { max-height: 75vh; max-width: 100%; object-fit: contain; border-radius: 16px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5); }
  .twitter-form-box { max-width: 380px; width: 100%; }
  
  /* Icon Container (Left Aligned for Register) */
  .icon-circle-left { width: 56px; height: 56px; background-color: rgba(29, 155, 240, 0.1); border-radius: 12px; margin-bottom: 20px; border: 1px solid rgba(29, 155, 240, 0.2); }

  .btn-twitter { border-radius: 50px; background-color: #1d9bf0; border: none; color: #ffffff; font-weight: 700; padding: 10px 0; }
  .btn-twitter:hover { background-color: #1a8cd8; color: #ffffff; }
  
  .form-control-twitter { background-color: rgba(22, 26, 32, 0.55); border: 1px solid rgba(255, 255, 255, 0.15); color: #ffffff; border-radius: 8px; padding: 12px 16px; backdrop-filter: blur(8px); }
  .form-control-twitter:focus { background-color: rgba(22, 26, 32, 0.85); border-color: #1d9bf0; color: #ffffff; box-shadow: 0 0 0 1px #1d9bf0; }
  .form-control-twitter::placeholder { color: #71767b; }
</style>

<div class="bg-wrapper">
  <div class="container content-container">
    <div class="row align-items-center justify-content-center min-vh-100 w-100 mx-auto py-4 py-lg-0">
      
      <!-- LEFT HALF: Form (Always text-start / Left-Aligned) -->
      <div class="col-12 col-lg-6 d-flex align-items-center justify-content-center p-3 p-lg-4 text-start">
        <div class="twitter-form-box">
          
          <!-- MOBILE ONLY ICON (d-flex on mobile, d-lg-none hides it on desktop) -->
          <div class="icon-circle-left d-flex d-lg-none align-items-center justify-content-center">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1d9bf0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="8.5" cy="7" r="4"></circle>
              <line x1="20" y1="8" x2="20" y2="14"></line>
              <line x1="23" y1="11" x2="17" y2="11"></line>
            </svg>
          </div>

          <h1 class="fw-bold fs-3 mb-2">Join the Crew!</h1>
          <p class="text-secondary mb-4">Create your account for Beban Hidup XII.</p>

          {{#if error}}
            <div class="alert alert-danger py-2 rounded-3 mb-4" role="alert">{{error}}</div>
          {{/if}}

          <form action="/register" method="POST">
            <div class="mb-3">
              <label for="username" class="form-label small text-secondary fw-semibold">Username</label>
              <input type="text" class="form-control form-control-twitter" id="username" name="username" placeholder="Choose a username" required>
            </div>
            <div class="mb-4">
              <label for="password" class="form-label small text-secondary fw-semibold">Password</label>
              <input type="password" class="form-control form-control-twitter" id="password" name="password" placeholder="Create a password" required>
            </div>
            <button type="submit" class="btn btn-twitter w-100 fs-6 shadow-sm mb-3">Sign Up</button>
          </form>
          
          <p class="text-secondary mt-4 mb-0">
            Already have an account? <a href="/login" class="text-primary text-decoration-none fw-semibold">Log In</a>
          </p>

        </div>
      </div>

      <!-- RIGHT HALF: Image (Hidden on Mobile) -->
      <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center p-4">
        <img src="/images/homeimage.jpeg" class="hero-img" alt="Beban Hidup XII Group Photo">
      </div>

    </div>
  </div>
</div>