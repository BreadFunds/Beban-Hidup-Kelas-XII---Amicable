<style>
  html, body {
    /* Matched dark charcoal tone sampled from the image shadows */
    background-color: #0e1013;
    color: #f7f9f9;
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100vh;
  }

  /* Full-screen wrapper holding the whole layout */
  .bg-wrapper {
    position: relative;
    min-height: 100vh;
    width: 100%;
    overflow: hidden;
    background-color: #0e1013;
  }

  /* Blurred background fill with transparency */
  .bg-wrapper::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: url('/images/homeimage.jpeg') center/cover no-repeat;
    filter: blur(45px) brightness(0.65);
    opacity: 0.35; /* Adjust this (0.1 to 1.0) to make the background more or less transparent */
    transform: scale(1.2);
    z-index: 0;
  }

  /* Vignette: Lightened radial fade to keep the image transparent and soft */
  .bg-wrapper::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(ellipse at center, rgba(14, 16, 19, 0) 20%, rgba(14, 16, 19, 0.5) 75%, #0e1013 100%);
    pointer-events: none;
    z-index: 0;
  }

  /* Ensures form and photo content sit above the background layers */
  .content-container {
    position: relative;
    z-index: 1;
  }

  /* Sharp, uncropped centered image on the left */
  .hero-img {
    max-height: 82vh;
    max-width: 90%;
    object-fit: contain;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  /* Form Container Width */
  .twitter-form-box {
    max-width: 380px;
    width: 100%;
  }

  /* Twitter-style Button */
  .btn-twitter {
    border-radius: 50px;
    background-color: #1d9bf0;
    border: none;
    color: #ffffff;
    font-weight: 700;
    padding: 10px 0;
  }
  .btn-twitter:hover {
    background-color: #1a8cd8;
    color: #ffffff;
  }

  /* Translucent Twitter-style Inputs */
  .form-control-twitter {
    background-color: rgba(22, 26, 32, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border-radius: 8px;
    padding: 12px 16px;
    backdrop-filter: blur(8px);
  }
  .form-control-twitter:focus {
    background-color: rgba(22, 26, 32, 0.85);
    border-color: #1d9bf0;
    color: #ffffff;
    box-shadow: 0 0 0 1px #1d9bf0;
  }
  .form-control-twitter::placeholder {
    color: #71767b;
  }
</style>

<div class="bg-wrapper">
  <div class="container-fluid p-0 content-container">
    <div class="row g-0 min-vh-100">
      
      <!-- Left Half: Sharp Uncropped Group Photo -->
      <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center p-4">
        <img src="/images/homeimage.jpeg" class="hero-img" alt="Beban Hidup XII Group Photo">
      </div>

      <!-- Right Half: Form over Ambient Blur -->
      <div class="col-12 col-lg-6 d-flex align-items-center justify-content-center p-4 p-md-5">
        <div class="twitter-form-box">
          
          <h1 class="fw-bold fs-2 mb-4 text-start">Welcome Back to Beban Hidup XII - Amicable!</h1>

          {{#if error}}
            <div class="alert alert-danger py-2 rounded-3 text-center mb-4" role="alert">
              {{error}}
            </div>
          {{/if}}

          <form action="/login" method="POST">
            <div class="mb-3">
              <label for="username" class="form-label small text-secondary fw-semibold">Username</label>
              <input 
                type="text" 
                class="form-control form-control-twitter" 
                id="username" 
                name="username" 
                placeholder="Username" 
                required
              >
            </div>

            <div class="mb-4">
              <label for="password" class="form-label small text-secondary fw-semibold">Password</label>
              <input 
                type="password" 
                class="form-control form-control-twitter" 
                id="password" 
                name="password" 
                placeholder="Password" 
                required
              >
            </div>

            <button type="submit" class="btn btn-twitter w-100 fs-6 shadow-sm mb-3">
              Log In
            </button>
          </form>

          <p class="text-secondary mt-4 text-start mb-0">
            Don't have an account? <a href="/register" class="text-primary text-decoration-none fw-semibold">Sign up</a>
          </p>

        </div>
      </div>

    </div>
  </div>
</div>