{{!-- views/admin.handlebars --}}
<style>
  .sidebar {
    background: var(--bg-soft);
    border-right: 1px solid var(--border);
    min-height: calc(100vh - 61px);
  }
  .sidebar .nav-link {
    color: var(--text-muted);
    font-weight: 500;
    font-size: .92rem;
    border-radius: 10px;
    padding: .55rem .8rem;
    margin-bottom: .15rem;
    border-left: 3px solid transparent;
  }
  .sidebar .nav-link i { width: 20px; }
  .sidebar .nav-link.active {
    background: var(--accent-dim);
    color: var(--text);
    border-left: 3px solid var(--accent);
  }
  .sidebar .nav-link:hover { color: var(--text); }
  .class-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .stat-chip {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  .stat-num { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.7rem; line-height: 1; color: var(--text); }
  .stat-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: var(--text-faint); font-weight: 600; margin-top: .25rem; }
  
  .card-form {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
  }
  .admin-table-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
  }
</style>

<div class="container-fluid">
  <div class="row g-0">
    
    <!-- SIDEBAR -->
    <div class="col-12 col-lg-2 sidebar p-3">
      <div class="class-card p-3 mb-3">
        <div style="font-size:.68rem; letter-spacing:.06em; text-transform:uppercase; color:var(--text-faint); font-weight:600;">Logged in as</div>
        <div class="fw-semibold mt-1">{{user.username}}</div>
        <div class="text-secondary" style="font-size:.78rem;">Class Admin</div>
      </div>
      
      <nav class="nav flex-column">
        <a class="nav-link" href="/dashboard"><i class="bi bi-card-checklist"></i> Assignments</a>
        <a class="nav-link" href="#"><i class="bi bi-chat-dots"></i> Messages</a>
        <a class="nav-link active" href="/admin"><i class="bi bi-shield-lock"></i> Admin Panel</a>
      </nav>
    </div>

    <!-- MAIN ADMIN CONTENT -->
    <div class="col-12 col-lg-10 p-3 p-lg-4">
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <div class="font-display fs-3">Admin Control Panel</div>
          <div class="text-secondary" style="font-size:.88rem;">
            Manage posted work, create new assignments, and monitor system activity.
          </div>
        </div>
      </div>

      <!-- STAT STRIP -->
      <div class="row g-2 mb-4">
        <div class="col-6 col-md-4">
          <div class="stat-chip p-3">
            <div class="stat-num">{{assignments.length}}</div>
            <div class="stat-label">Active Assignments</div>
          </div>
        </div>
        <div class="col-6 col-md-4">
          <div class="stat-chip p-3">
            <div class="stat-num text-danger">{{archivedAssignments.length}}</div>
            <div class="stat-label">Archived / Expired</div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="stat-chip p-3">
            <div class="stat-num text-info">{{userCount}}</div>
            <div class="stat-label">Registered Students</div>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <!-- LEFT: ASSIGNMENT MANAGEMENT TABLE -->
        <div class="col-12 col-lg-7">
          <div class="admin-table-card p-3">
            <div class="font-display fs-5 mb-3">All Assignments</div>

            {{#if assignments.length}}
              <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                  <thead>
                    <tr class="text-secondary small border-secondary">
                      <th>TITLE</th>
                      <th>SUBJECT</th>
                      <th>DUE DATE</th>
                      <th class="text-end">ACTIONS</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each assignments}}
                      <tr class="border-secondary">
                        <td class="fw-semibold">{{this.title}}</td>
                        <td><span class="badge bg-secondary">{{this.subject}}</span></td>
                        <td class="small">{{this.formattedDueDate}}</td>
                        <td class="text-end">
                          <form action="/assignments/delete/{{this._id}}" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this assignment permanently?')">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        </td>
                      </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            {{else}}
              <p class="text-secondary py-3 text-center mb-0">No active assignments posted.</p>
            {{/if}}
          </div>
        </div>

        <!-- RIGHT: CREATE NEW ASSIGNMENT FORM -->
        <div class="col-12 col-lg-5">
          <div class="card-form p-4">
            <div class="font-display fs-5 mb-3"><i class="bi bi-plus-circle me-1"></i> Post New Assignment</div>
            
            <form action="/assignments" method="POST">
              <div class="mb-3">
                <label class="form-label small fw-semibold">Title</label>
                <input type="text" name="title" class="form-control" placeholder="e.g. Chapter 4 Quiz Prep" required>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-semibold">Subject / Unit</label>
                <input type="text" name="subject" class="form-control" placeholder="e.g. Biology Honors" required>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-semibold">Description</label>
                <textarea name="description" class="form-control" rows="3" placeholder="Instructions, references..." required></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-semibold">Deadline</label>
                <input type="datetime-local" name="dueDate" class="form-control" value="{{this.rawDueDate}}" required>
              </div>

              <button type="submit" class="btn btn-accent w-100 py-2">
                <i class="bi bi-send me-1"></i> Publish Assignment
              </button>
            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>