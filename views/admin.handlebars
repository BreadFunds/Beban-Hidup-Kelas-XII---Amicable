<style>
  :root {
    --bg: #0c0d0f;
    --bg-soft: #131417;
    --surface: #17181c;
    --surface-2: #1d1f24;
    --border: rgba(255, 255, 255, .08);
    --border-soft: rgba(255, 255, 255, .05);
    --text: #f2f3f5;
    --text-muted: #9298a3;
    --text-faint: #676c76;
    --accent: #2f9bf0;
    --accent-dim: rgba(47, 155, 240, .14);
    --red: #f0553f;
    --red-dim: rgba(240, 85, 63, .13);
  }

  .font-display {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    letter-spacing: -.01em;
  }

  .sidebar {
    background: var(--bg-soft);
    border-right: 1px solid var(--border);
    min-height: calc(100vh - 61px);
  }

  .sidebar .nav-link {
    color: var(--text-muted);
    font-weight: 500;
    font-size: .92rem;
    border-radius: 10px;
    padding: .55rem .8rem;
    margin-bottom: .15rem;
    border-left: 3px solid transparent;
    white-space: nowrap;
  }

  .sidebar .nav-link i {
    width: 20px;
  }

  .sidebar .nav-link.active {
    background: var(--accent-dim);
    color: var(--text);
    border-left: 3px solid var(--accent);
  }

  .sidebar .nav-link:hover {
    color: var(--text);
  }

  .class-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .divider {
    border-top: 1px solid var(--border);
  }

  .stat-chip {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  .stat-num {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--text);
  }

  .stat-label {
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--text-faint);
    font-weight: 600;
    margin-top: .25rem;
  }

  .card-form {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .admin-table-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  .btn-accent {
    background: var(--accent);
    color: #fff;
    border: none;
    font-weight: 600;
    font-size: .85rem;
    border-radius: 10px;
  }

  .btn-accent:hover {
    background: #2489d9;
    color: #fff;
  }

  .form-control,
  .form-select {
    border-radius: 10px;
    border: 1px solid var(--border);
    font-size: .9rem;
    background: var(--surface-2);
    color: var(--text);
  }

  .form-control:focus,
  .form-select:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 .2rem var(--accent-dim);
    background: var(--surface-2);
    color: var(--text);
  }

  .form-label {
    color: var(--text-muted);
  }

  .section-title-wrapper {
    padding-bottom: .5rem;
    border-bottom: 1px solid var(--border);
  }

  /* Mobile Responsive Adaptations */
  @media (max-width: 991.98px) {
    .sidebar {
      min-height: auto;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .sidebar-nav-container {
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      gap: 0.5rem;
      padding-bottom: 0.25rem;
    }

    .sidebar .nav-link {
      border-left: none;
      border-bottom: 3px solid transparent;
      padding: .4rem .75rem;
    }

    .sidebar .nav-link.active {
      border-left: none;
      border-bottom: 3px solid var(--accent);
    }

    .stat-num {
      font-size: 1.3rem;
    }
  }
</style>

<div class="container-fluid p-0">
  <div class="row g-0">

    <!-- SIDEBAR -->
    <div class="col-12 col-lg-2 sidebar p-3">
      <div class="class-card p-3 mb-3 d-flex d-lg-block justify-content-between align-items-center">
        <div>
          <div
            style="font-size:.68rem; letter-spacing:.06em; text-transform:uppercase; color:var(--text-faint); font-weight:600;">
            Logged in as</div>
          <div class="fw-semibold mt-1">{{user.username}}</div>
        </div>
        <div class="text-secondary" style="font-size:.78rem;">Class Admin</div>
      </div>

      <nav class="nav sidebar-nav-container flex-lg-column mb-2 mb-lg-0">
        <a class="nav-link" href="/dashboard"><i class="bi bi-card-checklist"></i> Assignments</a>
        <a class="nav-link" href="/materials"><i class="bi bi-folder2-open"></i> Class materials</a>
        {{#if isAdmin}}
        <a class="nav-link active" href="/admin"><i class="bi bi-shield-lock"></i> Admin Panel</a>
        {{/if}}
        <a class="nav-link" href="https://wa.me/{{phone_number}}?text={{message}}"><i class="bi bi-chat-dots"></i>
          Message admin</a>
      </nav>
    </div>

    <!-- MAIN ADMIN CONTENT -->
    <div class="col-12 col-lg-10 p-3 p-lg-4">

      {{#if error}}
      <div class="alert alert-danger py-2 px-3 mb-3" style="font-size: 0.85rem; border-radius: 10px;">
        {{error}}
      </div>
      {{/if}}

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <div class="font-display fs-3">Admin Control Panel</div>
          <div class="text-secondary" style="font-size:.88rem;">
            Manage posted work, create new assignments, and upload class materials.
          </div>
        </div>
      </div>

      <!-- STAT STRIP -->
      <div class="row g-2 mb-4">
        <div class="col-6 col-sm-3">
          <div class="stat-chip p-3">
            <div class="stat-num">{{assignments.length}}</div>
            <div class="stat-label">Active Tasks</div>
          </div>
        </div>
        <div class="col-6 col-sm-3">
          <div class="stat-chip p-3">
            <div class="stat-num text-danger">{{archivedAssignments.length}}</div>
            <div class="stat-label">Archived</div>
          </div>
        </div>
        <div class="col-6 col-sm-3">
          <div class="stat-chip p-3">
            <div class="stat-num text-warning">{{materials.length}}</div>
            <div class="stat-label">Materials</div>
          </div>
        </div>
        <div class="col-6 col-sm-3">
          <div class="stat-chip p-3">
            <div class="stat-num text-info">{{userCount}}</div>
            <div class="stat-label">Students</div>
          </div>
        </div>
      </div>

      <!-- SECTION 1: ASSIGNMENTS -->
      <div class="section-title-wrapper mb-3">
        <h4 class="font-display m-0 fs-5"><i class="bi bi-journal-text me-2"></i>Assignments Management</h4>
      </div>

      <div class="row g-4 mb-4">
        <!-- LEFT: ASSIGNMENT MANAGEMENT TABLE -->
        <div class="col-12 col-lg-7">
          <div class="admin-table-card p-3">
            <div class="font-display fs-6 mb-3 text-secondary">All Active Assignments</div>

            {{#if assignments.length}}
            <div class="table-responsive">
              <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                <thead>
                  <tr class="text-secondary small border-secondary">
                    <th>TITLE</th>
                    <th>SUBJECT</th>
                    <th>DUE DATE</th>
                    <th class="text-end">ACTIONS</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each assignments}}
                  <tr class="border-secondary">
                    <td class="fw-semibold">{{this.title}}</td>
                    <td><span class="badge bg-secondary">{{this.subject}}</span></td>
                    <td class="small">{{this.formattedDueDate}}</td>
                    <td class="text-end">
                      <button class="btn btn-sm btn-outline-dark2" data-bs-toggle="modal"
                        data-bs-target="#editModal-{{this._id}}">
                        <i class="bi bi-pencil"></i>
                      </button>
                      <form action="/assignments/delete/{{this._id}}" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                          onclick="return confirm('Delete assignment?')">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>

            <!-- MODALS GENERATED HERE: Outside the table, inside a new loop -->
            {{#each assignments}}
            <div class="modal fade" id="editModal-{{this._id}}" tabindex="-1">
              <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                  <form action="/assignments/update/{{this._id}}" method="POST">
                    <div class="modal-header border-secondary">
                      <h5 class="modal-title font-display fs-5">Edit Assignment</h5>
                      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                      <div class="mb-3">
                        <label class="form-label small">Title</label>
                        <input type="text" name="title" class="form-control" value="{{this.title}}" required>
                      </div>
                      <div class="mb-3">
                        <label class="form-label small">Lesson / Subject</label>
                        <input type="text" name="subject" class="form-control" value="{{this.subject}}" required>
                      </div>
                      <div class="mb-3">
                        <label class="form-label small">Description</label>
                        <textarea name="description" class="form-control" rows="3"
                          required>{{this.description}}</textarea>
                      </div>
                      <div class="mb-3">
                        <label class="form-label small">Deadline</label>
                        <input type="datetime-local" name="dueDate" class="form-control" value="{{this.rawDueDate}}"
                          required>
                      </div>
                    </div>
                    <div class="modal-footer border-secondary">
                      <button type="button" class="btn btn-outline-dark2 btn-sm"
                        data-bs-dismiss="modal">Cancel</button>
                      <button type="submit" class="btn btn-accent btn-sm">Save Changes</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
            {{/each}}

            {{else}}
            <p class="text-secondary py-3 text-center mb-0">No active assignments posted.</p>
            {{/if}}
          </div>
        </div>

        <!-- RIGHT: CREATE NEW ASSIGNMENT FORM -->
        <div class="col-12 col-lg-5">
          <div class="card-form p-3 p-sm-4">
            <div class="font-display fs-6 mb-3"><i class="bi bi-plus-circle me-1"></i> Post New Assignment</div>

            <form action="/assignments" method="POST">
              <div class="mb-3">
                <label class="form-label small fw-semibold">Title</label>
                <input type="text" name="title" class="form-control" placeholder="e.g. Chapter 4 Quiz Prep" required>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-semibold">Subject / Unit</label>
                <input type="text" name="subject" class="form-control" placeholder="e.g. Biology Honors" required>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-semibold">Description</label>
                <textarea name="description" class="form-control" rows="3" placeholder="Instructions, references..."
                  required></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-semibold">Deadline</label>
                <input type="datetime-local" name="dueDate" class="form-control" required>
              </div>

              <button type="submit" class="btn btn-accent w-100 py-2">
                <i class="bi bi-send me-1"></i> Publish Assignment
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- SECTION SEPARATOR LINE -->
      <div class="my-5 divider"></div>

      <!-- SECTION 2: CLASS MATERIALS -->
      <div class="section-title-wrapper mb-3">
        <h4 class="font-display m-0 fs-5"><i class="bi bi-folder2-open me-2"></i>Class Materials Management</h4>
      </div>

      <div class="row g-4">
        <!-- LEFT: POSTED MATERIALS LIST -->
        <div class="col-12 col-lg-7">
          <div class="admin-table-card p-3">
            <div class="font-display fs-6 mb-3 text-secondary">All Uploaded Files</div>

            {{#if materials.length}}
            <div class="table-responsive">
              <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                <thead>
                  <tr class="text-secondary small border-secondary">
                    <th>TITLE</th>
                    <th>SUBJECT</th>
                    <th>FILE NAME</th>
                    <th class="text-end">ACTIONS</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each materials}}
                  <tr class="border-secondary">
                    <td class="fw-semibold">{{this.title}}</td>
                    <td><span class="badge bg-secondary">{{this.subject}}</span></td>
                    <td class="small text-truncate" style="max-width: 130px;">{{this.originalName}}</td>
                    <td class="text-end">
                      <a href="{{this.filePath}}" download class="btn btn-sm btn-outline-light me-1" title="Download">
                        <i class="bi bi-download"></i>
                      </a>
                      <form action="/materials/delete/{{this._id}}" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                          onclick="return confirm('Delete this material permanently?')" title="Delete">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
            {{else}}
            <p class="text-secondary py-3 text-center mb-0">No materials posted yet.</p>
            {{/if}}
          </div>
        </div>

        <!-- RIGHT: UPLOAD NEW MATERIAL FORM -->
        <div class="col-12 col-lg-5">
          <div class="card-form p-3 p-sm-4">
            <div class="font-display fs-6 mb-3"><i class="bi bi-upload me-1"></i> Upload New Material</div>

            <form action="/materials" method="POST" enctype="multipart/form-data">
              <div class="mb-3">
                <label class="form-label small fw-semibold">Title</label>
                <input type="text" name="title" class="form-control" placeholder="e.g. Chapter 1 Notes" required>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-semibold">Subject</label>
                <input type="text" name="subject" class="form-control" placeholder="e.g. History" required>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-semibold">Description</label>
                <textarea name="description" class="form-control" rows="2"
                  placeholder="Short description..."></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-semibold">File Attachment(s)</label>
                <input type="file" name="materialFiles" class="form-control" multiple required>
                <div class="form-text text-secondary" style="font-size: 0.75rem;">You can select multiple files at once.
                </div>
              </div>

              <button type="submit" class="btn btn-accent w-100 py-2">
                <i class="bi bi-cloud-upload me-1"></i> Post Material
              </button>
            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>