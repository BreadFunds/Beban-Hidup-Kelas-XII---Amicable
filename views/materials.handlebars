<style>
  :root {
    --bg: #0c0d0f;
    --bg-soft: #131417;
    --surface: #17181c;
    --surface-2: #1d1f24;
    --border: rgba(255, 255, 255, .08);
    --border-soft: rgba(255, 255, 255, .05);
    --text: #f2f3f5;
    --text-muted: #9298a3;
    --text-faint: #676c76;
    --accent: #2f9bf0;
    --accent-dim: rgba(47, 155, 240, .14);
    --red: #f0553f;
    --red-dim: rgba(240, 85, 63, .13);
  }

  body {
    background: radial-gradient(circle at 25% 15%, #1a1c20 0%, var(--bg) 55%);
    font-family: 'Inter', sans-serif;
    color: var(--text);
    min-height: 100vh;
  }

  .font-display {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    letter-spacing: -.01em;
  }

  .sidebar {
    background: var(--bg-soft);
    border-right: 1px solid var(--border);
    min-height: calc(100vh - 61px);
  }

  .sidebar .nav-link {
    color: var(--text-muted);
    font-weight: 500;
    font-size: .92rem;
    border-radius: 10px;
    padding: .55rem .8rem;
    margin-bottom: .15rem;
    border-left: 3px solid transparent;
    white-space: nowrap;
  }

  .sidebar .nav-link i {
    width: 20px;
  }

  .sidebar .nav-link.active {
    background: var(--accent-dim);
    color: var(--text);
    border-left: 3px solid var(--accent);
  }

  .sidebar .nav-link:hover {
    color: var(--text);
  }

  .class-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .stat-chip {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  .btn-accent {
    background: var(--accent);
    color: #fff;
    border: none;
    font-weight: 600;
  }

  .btn-accent:hover {
    background: #2489d9;
    color: #fff;
  }

  .m-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 1.25rem;
    transition: transform .15s ease, border-color .15s ease;
  }

  .m-card:hover {
    border-color: rgba(255, 255, 255, .2);
    transform: translateY(-2px);
  }

  .m-preview-wrapper {
    height: 160px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .m-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
    transition: opacity .15s ease;
  }

  .m-preview-img:hover {
    opacity: .9;
  }

  .m-preview-icon {
    font-size: 3rem;
    color: var(--accent);
  }

  .m-body {
    padding: 1.1rem;
  }

  .m-title {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: .98rem;
    color: var(--text);
  }

  .subject-pill {
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .02em;
    border-radius: 6px;
    padding: .15rem .5rem;
    display: inline-block;
    background: var(--accent-dim);
    color: var(--accent);
  }

  .m-desc {
    font-size: .85rem;
    color: var(--text-muted);
    margin: .4rem 0 .55rem;
  }

  .m-meta {
    font-size: .78rem;
    color: var(--text-muted);
  }

  .file-item {
    background: var(--surface-2);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    padding: .4rem .6rem;
  }

  .icon-btn {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: background .15s ease, color .15s ease, border-color .15s ease;
  }

  .icon-btn:hover {
    color: var(--text);
    background: var(--accent);
    border-color: var(--accent);
  }

  .icon-btn.btn-delete:hover {
    color: #fff;
    background: var(--red);
    border-color: var(--red);
  }

  /* Modal Styling */
  .modal-content {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 16px;
  }

  .modal-header {
    border-bottom: 1px solid var(--border);
  }

  .modal-footer {
    border-top: 1px solid var(--border);
  }

  .form-control,
  .form-select {
    border-radius: 10px;
    border: 1px solid var(--border);
    font-size: .9rem;
    background: var(--surface-2);
    color: var(--text);
  }

  .form-control:focus,
  .form-select:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 .2rem var(--accent-dim);
    background: var(--surface-2);
    color: var(--text);
  }

  .form-label {
    color: var(--text-muted);
  }

  /* Custom input number spinners hide for cleaner UI */
  input[type=number]::-webkit-inner-spin-button, 
  input[type=number]::-webkit-outer-spin-button { 
    -webkit-appearance: none; 
    margin: 0; 
  }
  input[type=number] {
    -moz-appearance: textfield;
  }

  /* Mobile Responsive Adaptations */
  @media (max-width: 991.98px) {
    .sidebar {
      min-height: auto;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .sidebar-nav-container {
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      gap: 0.5rem;
      padding-bottom: 0.25rem;
    }

    .sidebar .nav-link {
      border-left: none;
      border-bottom: 3px solid transparent;
      padding: .4rem .75rem;
    }

    .sidebar .nav-link.active {
      border-left: none;
      border-bottom: 3px solid var(--accent);
    }
  }
</style>

<div class="container-fluid p-0">
  <div class="row g-0">
    <!-- Sidebar -->
    <div class="col-12 col-lg-2 sidebar p-3">
      <div class="class-card p-3 mb-3 d-flex d-lg-block justify-content-between align-items-center">
        <div>
          <div style="font-size:.68rem; letter-spacing:.06em; text-transform:uppercase; color:var(--text-faint); font-weight:600;">
            Logged in as
          </div>
          <div class="fw-semibold mt-1">{{user.username}}</div>
        </div>
        <div class="text-secondary" style="font-size:.78rem;">{{#if isAdmin}}Class Admin{{else}}Student{{/if}}</div>
      </div>

      <nav class="nav sidebar-nav-container flex-lg-column mb-2 mb-lg-0">
        <a class="nav-link" href="/dashboard"><i class="bi bi-card-checklist"></i> Assignments</a>
        <a class="nav-link active" href="/materials"><i class="bi bi-folder2-open"></i> Class materials</a>
        {{#if isAdmin}}
        <a class="nav-link" href="/admin"><i class="bi bi-shield-lock"></i> Admin Panel</a>
        {{/if}}
        <a class="nav-link" href="https://wa.me/{{phone_number}}?text={{message}}"><i class="bi bi-chat-dots"></i> Message admin</a>
      </nav>

      {{#if isAdmin}}
      <button class="btn btn-accent w-100 btn-sm mt-2 mt-lg-3" data-bs-toggle="modal" data-bs-target="#newMaterialModal">
        <i class="bi bi-plus-lg me-1"></i> New Material
      </button>
      {{/if}}
    </div>

    <!-- Main Content Area -->
    <div class="col-12 col-lg-10 p-3 p-lg-4">
      {{#if error}}
      <div class="alert alert-danger py-2 px-3 mb-3" style="font-size: 0.85rem; border-radius: 10px;">
        {{error}}
      </div>
      {{/if}}

      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
          <div class="font-display fs-3">Class materials</div>
          <div class="text-secondary" style="font-size:.9rem;">Slides, handouts, photos, and reference files posted by your teacher.</div>
        </div>

        <!-- SEARCH INPUT -->
        <div class="position-relative" style="min-width: 260px;">
          <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary"></i>
          <input type="text" id="materialSearchInput" class="form-control ps-5" placeholder="Search materials..." onkeyup="filterMaterials()">
        </div>
      </div>

      <div class="stat-chip p-2 px-3 mb-4 d-inline-block">
        <span class="text-secondary" style="font-size:.82rem;">
          <i class="bi bi-folder2 me-1"></i>{{materials.length}} materials available
        </span>
      </div>

      <div class="row g-3">
        {{#if materials.length}}
        {{#each materials}}
        <div class="col-12 col-md-6 col-xl-4">
          <div class="m-card" data-material-id="{{this._id}}">

            <!-- FILE PREVIEW HEADER -->
            <div class="m-preview-wrapper">
              {{#each this.files}}
              {{#if @first}}
              {{#if this.isImage}}
              <img src="{{this.filePath}}" alt="{{../this.title}}" class="m-preview-img" data-bs-toggle="modal"
                data-bs-target="#imagePreviewModal" onclick="openGalleryFromPath('{{../this._id}}', '{{this.filePath}}')">
              {{else}}
              <div class="m-preview-icon">
                <i class="bi bi-folder2-open"></i>
              </div>
              {{/if}}
              {{/if}}
              {{/each}}
            </div>

            <!-- CARD CONTENT -->
            <div class="m-body">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <div class="m-title text-truncate" title="{{this.title}}">{{this.title}}</div>
                <span class="subject-pill ms-2">{{this.subject}}</span>
              </div>

              <div class="m-desc text-truncate-2">{{this.description}}</div>

              <!-- ADMIN CONTROLS -->
              {{#if ../isAdmin}}
              <div class="d-flex gap-1 align-items-center justify-content-end mb-2 pt-2 border-top border-secondary border-opacity-10">
                <button class="icon-btn" title="Edit Material" data-bs-toggle="modal"
                  data-bs-target="#editMaterialModal"
                  onclick="populateEditModal('{{this._id}}', '{{this.title}}', '{{this.subject}}', '{{this.description}}')">
                  <i class="bi bi-pencil"></i>
                </button>

                <form action="/materials/delete/{{this._id}}" method="POST" class="d-inline m-0">
                  <button type="submit" class="icon-btn btn-delete" title="Delete Material"
                    onclick="return confirm('Delete this material permanently?')">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </div>
              {{/if}}

              <!-- ATTACHED FILES LIST -->
              <div class="pt-2 border-top border-secondary border-opacity-10">
                <div class="text-secondary mb-2" style="font-size: .75rem; font-weight: 600;">
                  ATTACHED FILES ({{this.files.length}})
                </div>
                <div class="d-flex flex-column gap-2">
                  {{#each this.files}}
                  <div class="file-item d-flex align-items-center justify-content-between">
                    <span class="m-meta text-truncate me-2" title="{{this.originalName}}">
                      <i class="bi {{#if this.isImage}}bi-image text-info{{else}}bi-paperclip{{/if}} me-1"></i>{{this.originalName}}
                    </span>

                    <div class="d-flex gap-1 align-items-center flex-shrink-0">
                      {{#if this.isImage}}
                      <button class="icon-btn btn-view-image" title="View Image" data-bs-toggle="modal"
                        data-bs-target="#imagePreviewModal"
                        data-filepath="{{this.filePath}}"
                        data-filename="{{this.originalName}}"
                        onclick="openGalleryFromPath('{{../this._id}}', '{{this.filePath}}')">
                        <i class="bi bi-eye"></i>
                      </button>
                      {{/if}}

                      <a href="{{this.filePath}}" download="{{this.originalName}}" class="icon-btn text-decoration-none" title="Download">
                        <i class="bi bi-download"></i>
                      </a>
                    </div>
                  </div>
                  {{/each}}
                </div>
              </div>

            </div>
          </div>
        </div>
        {{/each}}
        {{else}}
        <div class="col-12 text-center py-5 text-secondary">
          <i class="bi bi-folder2-open fs-1 d-block mb-2"></i>
          No class materials have been uploaded yet.
        </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>

<!-- FULL IMAGE PREVIEW MODAL WITH GALLERY NAVIGATION & INTERACTIVE ZOOM -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content bg-dark border-secondary position-relative">
      <div class="modal-header border-secondary py-2 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
          <h6 class="modal-title font-display text-light m-0" id="previewModalTitle">Photo Preview</h6>
          <span class="badge bg-secondary opacity-75" id="previewModalCounter" style="font-size: 0.72rem;"></span>
        </div>

        <!-- ZOOM CONTROLS TOOLBAR -->
        <div class="d-flex align-items-center gap-1 ms-2 me-2">
          <button type="button" class="btn btn-sm btn-outline-secondary text-light" onclick="zoomImage(-0.25)" title="Zoom Out">
            <i class="bi bi-zoom-out"></i>
          </button>
          
          <!-- Interactive Zoom Percentage Input -->
          <div class="input-group input-group-sm" style="width: 75px;">
            <input type="number" id="zoomLevelInput" class="form-control text-center bg-dark text-light border-secondary p-0" 
                   value="100" min="50" max="400" step="5" onchange="handleZoomInput(this.value)" onkeydown="if(event.key==='Enter') this.blur();">
            <span class="input-group-text bg-dark text-muted border-secondary p-1" style="font-size: 0.75rem;">%</span>
          </div>

          <button type="button" class="btn btn-sm btn-outline-secondary text-light" onclick="zoomImage(0.25)" title="Zoom In">
            <i class="bi bi-zoom-in"></i>
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary text-light ms-1" onclick="resetZoom()" title="Reset Zoom">
            <i class="bi bi-arrow-counterclockwise"></i>
          </button>
        </div>

        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      
      <div class="modal-body p-0 text-center bg-black d-flex align-items-center justify-content-center position-relative overflow-hidden" style="height: 75vh;">
        <!-- Left Arrow Button -->
        <button type="button" class="btn btn-dark position-absolute start-0 top-50 translate-middle-y ms-2 rounded-circle z-3 opacity-75 border-secondary" id="prevImageBtn" onclick="navigateGallery(-1)" style="width: 42px; height: 42px;">
          <i class="bi bi-chevron-left fs-5"></i>
        </button>

        <!-- Container for Drag and Zooming -->
        <div id="imageContainer" style="cursor: grab; display: inline-block; user-select: none; transition: transform 0.1s ease-out;">
          <img src="" id="previewModalImage" class="img-fluid" style="max-height: 70vh; object-fit: contain; pointer-events: none;">
        </div>

        <!-- Right Arrow Button -->
        <button type="button" class="btn btn-dark position-absolute end-0 top-50 translate-middle-y me-2 rounded-circle z-3 opacity-75 border-secondary" id="nextImageBtn" onclick="navigateGallery(1)" style="width: 42px; height: 42px;">
          <i class="bi bi-chevron-right fs-5"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- NEW MATERIAL UPLOAD MODAL -->
{{#if isAdmin}}
<div class="modal fade" id="newMaterialModal" tabindex="-1" aria-labelledby="newMaterialModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title font-display fs-5" id="newMaterialModalLabel">
          <i class="bi bi-upload me-1"></i> Upload New Material
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/materials" method="POST" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Title</label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Chapter 1 Notes" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Subject</label>
            <input type="text" name="subject" class="form-control" placeholder="e.g. History" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Description</label>
            <textarea name="description" class="form-control" rows="2" placeholder="Short description..."></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">File Attachment(s)</label>
            <input type="file" name="materialFiles" class="form-control" multiple required>
            <div class="form-text text-secondary" style="font-size: 0.75rem;">You can select multiple files at once.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-accent btn-sm">
            <i class="bi bi-cloud-upload me-1"></i> Post Material
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- EDIT MATERIAL MODAL -->
<div class="modal fade" id="editMaterialModal" tabindex="-1" aria-labelledby="editMaterialModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title font-display fs-5" id="editMaterialModalLabel">
          <i class="bi bi-pencil me-1"></i> Edit Material
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editMaterialForm" action="" method="POST" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Title</label>
            <input type="text" id="editTitle" name="title" class="form-control" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Subject</label>
            <input type="text" id="editSubject" name="subject" class="form-control" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Description</label>
            <textarea id="editDescription" name="description" class="form-control" rows="2"></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Replace File (Optional)</label>
            <input type="file" name="materialFiles" class="form-control" multiple>
            <div class="form-text text-secondary" style="font-size: 0.75rem;">Leave blank to keep the existing files.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-accent btn-sm">
            <i class="bi bi-check-lg me-1"></i> Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
{{/if}}

<script>
  // Dynamic Image Gallery State
  let activeGallery = [];
  let currentGalleryIndex = 0;

  // Zoom and Pan State Variables
  let zoomScale = 1;
  let translateX = 0;
  let translateY = 0;
  let isDragging = false;
  let startX = 0;
  let startY = 0;

  function openGalleryFromPath(materialId, targetPath) {
    activeGallery = [];

    const targetCard = document.querySelector(`.m-card[data-material-id="${materialId}"]`);

    if (targetCard) {
      const imageButtons = targetCard.querySelectorAll('.btn-view-image');

      imageButtons.forEach(btn => {
        const filePath = btn.getAttribute('data-filepath');
        const fileName = btn.getAttribute('data-filename');

        if (filePath) {
          activeGallery.push({
            filePath: filePath,
            title: fileName || 'Image Preview'
          });
        }
      });
    }

    const foundIndex = activeGallery.findIndex(item => item.filePath === targetPath);
    currentGalleryIndex = foundIndex !== -1 ? foundIndex : 0;

    renderGalleryItem();
  }

  function renderGalleryItem() {
    if (activeGallery.length === 0) return;

    resetZoom(); // Reset zoom every time image changes

    const item = activeGallery[currentGalleryIndex];
    document.getElementById('previewModalImage').src = item.filePath;
    document.getElementById('previewModalTitle').innerText = item.title;
    
    document.getElementById('previewModalCounter').innerText = 
      activeGallery.length > 1 ? `${currentGalleryIndex + 1} of ${activeGallery.length}` : '';

    const prevBtn = document.getElementById('prevImageBtn');
    const nextBtn = document.getElementById('nextImageBtn');

    if (activeGallery.length <= 1) {
      prevBtn.style.display = 'none';
      nextBtn.style.display = 'none';
    } else {
      prevBtn.style.display = 'block';
      nextBtn.style.display = 'block';
    }
  }

  function navigateGallery(direction) {
    if (activeGallery.length <= 1) return;
    
    currentGalleryIndex += direction;

    if (currentGalleryIndex < 0) {
      currentGalleryIndex = activeGallery.length - 1;
    } else if (currentGalleryIndex >= activeGallery.length) {
      currentGalleryIndex = 0;
    }

    renderGalleryItem();
  }

  // --- ZOOM & PAN CONTROLS ---

  function applyTransform() {
    const container = document.getElementById('imageContainer');
    const input = document.getElementById('zoomLevelInput');

    container.style.transform = `translate(${translateX}px, ${translateY}px) scale(${zoomScale})`;
    
    // Sync numerical input value unless user is currently typing inside it
    if (input && document.activeElement !== input) {
      input.value = Math.round(zoomScale * 100);
    }

    // Adjust cursor state based on zoom level
    if (zoomScale > 1) {
      container.style.cursor = isDragging ? 'grabbing' : 'grab';
    } else {
      container.style.cursor = 'default';
    }
  }

  function handleZoomInput(value) {
    let parsedValue = parseFloat(value);
    
    if (isNaN(parsedValue)) parsedValue = 100;
    parsedValue = Math.min(Math.max(50, parsedValue), 400); // Clamp 50% - 400%

    zoomScale = parsedValue / 100;
    if (zoomScale === 1) {
      translateX = 0;
      translateY = 0;
    }
    applyTransform();
  }

  function zoomImage(step) {
    zoomScale += step;
    zoomScale = Math.min(Math.max(0.5, zoomScale), 4); // Limit zoom between 50% and 400%

    if (zoomScale === 1) {
      translateX = 0;
      translateY = 0;
    }
    applyTransform();
  }

  function resetZoom() {
    zoomScale = 1;
    translateX = 0;
    translateY = 0;
    applyTransform();
  }

  // Mouse Wheel Zoom Event
  document.getElementById('imageContainer')?.addEventListener('wheel', (e) => {
    e.preventDefault();
    if (e.deltaY < 0) {
      zoomImage(0.15);
    } else {
      zoomImage(-0.15);
    }
  }, { passive: false });

  // Click & Drag Panning Logic
  const imgContainer = document.getElementById('imageContainer');

  imgContainer?.addEventListener('mousedown', (e) => {
    if (zoomScale <= 1) return; // Allow panning only when zoomed in
    isDragging = true;
    startX = e.clientX - translateX;
    startY = e.clientY - translateY;
    imgContainer.style.cursor = 'grabbing';
  });

  window.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    e.preventDefault();
    translateX = e.clientX - startX;
    translateY = e.clientY - startY;
    applyTransform();
  });

  window.addEventListener('mouseup', () => {
    if (isDragging) {
      isDragging = false;
      applyTransform();
    }
  });

  // Keyboard navigation & Shortcuts (Left / Right Arrow, Zoom +/-)
  document.addEventListener('keydown', (e) => {
    const modalEl = document.getElementById('imagePreviewModal');
    // Don't trigger keyboard shortcuts when actively typing in input fields
    if (modalEl && modalEl.classList.contains('show') && document.activeElement.tagName !== 'INPUT') {
      if (e.key === 'ArrowLeft') navigateGallery(-1);
      if (e.key === 'ArrowRight') navigateGallery(1);
      if (e.key === '+' || e.key === '=') zoomImage(0.25);
      if (e.key === '-') zoomImage(-0.25);
      if (e.key === '0') resetZoom();
    }
  });

  function populateEditModal(id, title, subject, description) {
    document.getElementById('editMaterialForm').action = '/materials/edit/' + id;
    document.getElementById('editTitle').value = title;
    document.getElementById('editSubject').value = subject;
    document.getElementById('editDescription').value = description;
  }

  function filterMaterials() {
    const query = document.getElementById('materialSearchInput').value.toLowerCase().trim();
    const cards = document.querySelectorAll('.row.g-3 > .col-12');
    let visibleCount = 0;

    cards.forEach(cardContainer => {
      if (cardContainer.id === 'noSearchMatches' || !cardContainer.querySelector('.m-card')) return;

      const cardText = cardContainer.innerText.toLowerCase();
      const isMatch = cardText.includes(query);

      if (isMatch) {
        cardContainer.style.display = '';
        visibleCount++;
      } else {
        cardContainer.style.display = 'none';
      }
    });

    let noResultsEl = document.getElementById('noSearchMatches');
    if (!noResultsEl) {
      noResultsEl = document.createElement('div');
      noResultsEl.id = 'noSearchMatches';
      noResultsEl.className = 'col-12 text-center py-5 text-secondary';
      noResultsEl.innerHTML = '<i class="bi bi-search fs-1 d-block mb-2"></i> No materials match your search.';
      document.querySelector('.row.g-3').appendChild(noResultsEl);
    }

    noResultsEl.style.display = (visibleCount === 0 && cards.length > 0) ? 'block' : 'none';
  }
</script> 